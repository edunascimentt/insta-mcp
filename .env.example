# Copy to .env and fill in. Never commit .env.

# Business Manager System User token (recommended: never expires).
# One token reaches every IG account in the business portfolio.
IG_ACCESS_TOKEN=

# Meta app credentials — only needed by auth_helper.py `exchange`.
IG_APP_ID=
IG_APP_SECRET=

# Optional: default account (username or ig id) used when a tool omits `account`.
# IG_DEFAULT_ACCOUNT=

# Optional: pin a different Graph API version (default v22.0)
# IG_GRAPH_VERSION=v22.0
